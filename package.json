{
    "name": "stgit-revived",
    "displayName": "StGit Revived",
    "description": "Git patch management tool using StGit. Actively maintained fork of srydh/vscode-stgit.",
    "version": "1.1.2",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "SCM Providers"
    ],
    "keywords": [
        "stg",
        "stgit",
        "stacked git",
        "patch",
        "patch series",
        "git"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/cedernaes/vscode-stgit"
    },
    "publisher": "cedernaes",
    "icon": "images/icon.png",
    "contributes": {
        "configuration": {
            "title": "StGit",
            "properties": {
                "stgit.showUnknownFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show unknown files in the StGit window. Note: this setting is the startup default; the visibility of unknown files can be toggled dynamically.",
                    "order": 1
                },
                "stgit.stgitExecutable": {
                    "type": "string",
                    "default": "stg",
                    "description": "Path to StGit binary (stg)",
                    "order": 1
                },
                "stgit.gitExecutable": {
                    "type": "string",
                    "default": "git",
                    "description": "Path to Git binary (git)"
                }
            }
        },
        "menus": {
            "comments/comment/context": [
                {
                    "command": "stgit.commentCreatePatch",
                    "when": "comment == stgit"
                },
                {
                    "command": "stgit.completePatchEdit",
                    "when": "comment == stgit-edit"
                }
            ],
            "commandPalette": [
                {
                    "command": "stgit.commentCreatePatch",
                    "when": "false"
                },
                {
                    "command": "stgit.completePatchEdit",
                    "when": "false"
                }
            ]
        },
        "languages": [
            {
                "id": "stgit-buffer",
                "filenames": [
                    "StGit"
                ]
            }
        ],
        "grammars": [
            {
                "language": "stgit-buffer",
                "scopeName": "source.stgit",
                "path": "./syntaxes/stgit.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "stgit.commentCreatePatch",
                "category": "StGit",
                "title": "Commit"
            },
            {
                "command": "stgit.completePatchEdit",
                "category": "StGit",
                "title": "Update"
            },
            {
                "command": "stgit.submitComment",
                "category": "StGit",
                "title": "Submit Commit Message"
            },
            {
                "command": "stgit.initializeBranch",
                "category": "StGit",
                "title": "Initialize Branch"
            },
            {
                "command": "stgit.open",
                "category": "StGit",
                "title": "Open and Focus the StGit Patch Editor"
            },
            {
                "command": "stgit.cancel",
                "category": "StGit",
                "title": "Cancel Ongoing StGit Operations (e.g. commit)"
            },
            {
                "command": "stgit.editCommitMessage",
                "category": "StGit",
                "title": "Edit Commit Message"
            },
            {
                "command": "stgit.copyCommitSha",
                "category": "StGit",
                "title": "Copy Full Commit SHA"
            },
            {
                "command": "stgit.squashPatches",
                "category": "StGit",
                "title": "Squash Selected Patches"
            },
            {
                "command": "stgit.deletePatches",
                "category": "StGit",
                "title": "Delete Patches"
            },
            {
                "command": "stgit.openDiffEditor",
                "category": "StGit",
                "title": "Open VSCode Diff Editor"
            },
            {
                "command": "stgit.showDiff",
                "category": "StGit",
                "title": "Show Diff"
            },
            {
                "command": "stgit.openDiff",
                "category": "StGit",
                "title": "Show Diff and Switch Focus"
            },
            {
                "command": "stgit.markPatch",
                "category": "StGit",
                "title": "Mark Patch at Point"
            },
            {
                "command": "stgit.unmarkPatch",
                "category": "StGit",
                "title": "Unmark patch at Point"
            },
            {
                "command": "stgit.help",
                "category": "StGit",
                "title": "Show All StGit Commands"
            },
            {
                "command": "stgit.toggleExpand",
                "category": "StGit",
                "title": "Toggle Expand"
            },
            {
                "command": "stgit.toggleShowingUnknown",
                "category": "StGit",
                "title": "Toggle Showing Unknown Files"
            },
            {
                "command": "stgit.repair",
                "category": "StGit",
                "title": "Repair (accomodate changes made with plain Git)",
                "shortTitle": "Repair"
            },
            {
                "command": "stgit.reload",
                "category": "StGit",
                "title": "Refresh State"
            },
            {
                "command": "stgit.resolveConflict",
                "category": "StGit",
                "title": "Mark Merge Conflict as Resolved"
            },
            {
                "command": "stgit.createBranch",
                "category": "StGit",
                "title": "Create Branch"
            },
            {
                "command": "stgit.switchBranch",
                "category": "StGit",
                "title": "Switch Branch"
            },
            {
                "command": "stgit.rebase",
                "category": "StGit",
                "title": "Rebase Patch Series"
            },
            {
                "command": "stgit.gitPush",
                "category": "StGit",
                "title": "Push Changes"
            },
            {
                "command": "stgit.gitForcePush",
                "category": "StGit",
                "title": "Push Changes (force)"
            },
            {
                "command": "stgit.gitFetch",
                "category": "StGit",
                "title": "Fetch Changes From Remote"
            },
            {
                "command": "stgit.selectRemote",
                "category": "StGit",
                "title": "Select Remote"
            },
            {
                "command": "stgit.selectUpstreamBranch",
                "category": "StGit",
                "title": "Select Upstream Branch"
            },
            {
                "command": "stgit.highlightFile",
                "category": "StGit",
                "title": "Highlight Patches Modifying File"
            },
            {
                "command": "stgit.cancelHighlighting",
                "category": "StGit",
                "title": "Cancel Patch Highlighting"
            },
            {
                "command": "stgit.gotoPatch",
                "category": "StGit",
                "title": "Goto Patch"
            },
            {
                "command": "stgit.pushOrPopPatches",
                "category": "StGit",
                "title": "Push or Pop Patches"
            },
            {
                "command": "stgit.pushNextPatch",
                "category": "StGit",
                "title": "Push Next Patch onto Stack"
            },
            {
                "command": "stgit.popCurrentPatch",
                "category": "StGit",
                "title": "Pop Current Patch from Stack"
            },
            {
                "command": "stgit.setHistorySize",
                "category": "StGit",
                "title": "Set History Size"
            },
            {
                "command": "stgit.movePatchesTo",
                "category": "StGit",
                "title": "Move Selected Patches"
            },
            {
                "command": "stgit.newPatch",
                "category": "StGit",
                "title": "Create New Empty Patch"
            },
            {
                "command": "stgit.createPatch",
                "category": "StGit",
                "title": "Create New Patch"
            },
            {
                "command": "stgit.commitOrUncommitPatches",
                "category": "StGit",
                "title": "Convert Patches to GIT Commits (or vice versa)"
            },
            {
                "command": "stgit.toggleChanges",
                "category": "StGit",
                "title": "Move Changes Between Index and Work Tree"
            },
            {
                "command": "stgit.revertChanges",
                "category": "StGit",
                "title": "Revert Changes in Index or Work Tree"
            },
            {
                "command": "stgit.undo",
                "category": "StGit",
                "title": "Undo Operation"
            },
            {
                "command": "stgit.hardUndo",
                "category": "StGit",
                "title": "Undo Operation (hard)"
            },
            {
                "command": "stgit.redo",
                "category": "StGit",
                "title": "Redo Operation"
            },
            {
                "command": "stgit.navigateToParent",
                "category": "StGit",
                "title": "Navigate to Parent Repository (from submodule)"
            },
            {
                "command": "stgit.refresh",
                "category": "StGit",
                "title": "Append Changes to Current Patch"
            },
            {
                "command": "stgit.refreshSpecific",
                "category": "StGit",
                "title": "Append Changes to Specified Patch"
            },
            {
                "command": "sdiff.applyHunk",
                "category": "SDiff",
                "title": "Apply Diff"
            },
            {
                "command": "sdiff.revertHunk",
                "category": "SDiff",
                "title": "Revert Diff"
            },
            {
                "command": "sdiff.stageHunk",
                "category": "SDiff",
                "title": "Stage Hunk"
            },
            {
                "command": "sdiff.unstageHunk",
                "category": "SDiff",
                "title": "Unstage Hunk"
            },
            {
                "command": "sdiff.splitHunk",
                "category": "SDiff",
                "title": "Split Diff"
            },
            {
                "command": "sdiff.openCurrentFileDiff",
                "category": "SDiff",
                "title": "Show Current File Changes as a Diff"
            },
            {
                "command": "sdiff.help",
                "category": "SDiff",
                "title": "Help"
            },
            {
                "command": "sdiff.gotoPreviousHunk",
                "category": "SDiff",
                "title": "Goto Previous Hunk"
            },
            {
                "command": "sdiff.gotoNextHunk",
                "category": "SDiff",
                "title": "Goto Next Hunk"
            },
            {
                "command": "sdiff.openFile",
                "category": "SDiff",
                "title": "Open File"
            }
        ],
        "keybindings": [
            {
                "key": "r",
                "command": "stgit.refresh",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl-u r",
                "command": "stgit.refreshSpecific",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "g",
                "command": "stgit.reload",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl-u g",
                "command": "stgit.repair",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+g",
                "command": "stgit.gotoPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+p",
                "command": "stgit.pushOrPopPatches",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+.",
                "command": "stgit.pushNextPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+,",
                "command": "stgit.popCurrentPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+h",
                "command": "stgit.setHistorySize",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+m",
                "command": "stgit.movePatchesTo",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c shift+b",
                "command": "stgit.createBranch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+b",
                "command": "stgit.switchBranch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "f",
                "command": "stgit.highlightFile",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+f",
                "command": "stgit.cancelHighlighting",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "u",
                "command": "stgit.unmarkPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "m",
                "command": "stgit.markPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "i",
                "command": "stgit.toggleChanges",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+u",
                "command": "stgit.revertChanges",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c ctrl+b",
                "command": "stgit.rebase",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c f",
                "command": "stgit.gitFetch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c p",
                "command": "stgit.gitPush",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c r",
                "command": "stgit.selectRemote",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c u",
                "command": "stgit.selectUpstreamBranch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+u p",
                "command": "stgit.gitForcePush",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+shift+-",
                "command": "stgit.undo",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+u ctrl+shift+-",
                "command": "stgit.hardUndo",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c ctrl+shift+-",
                "command": "stgit.redo",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+n",
                "command": "stgit.newPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "c",
                "command": "stgit.createPatch",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl-c ctrl-c",
                "command": "stgit.commitOrUncommitPatches",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "h",
                "command": "stgit.help",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "-",
                "command": "stgit.navigateToParent",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "t",
                "command": "stgit.toggleShowingUnknown",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+R",
                "command": "stgit.resolveConflict",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "e",
                "command": "stgit.editCommitMessage",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+s",
                "command": "stgit.squashPatches",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+d",
                "command": "stgit.deletePatches",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "shift+=",
                "command": "stgit.openDiffEditor",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "=",
                "command": "stgit.showDiff",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "alt-=",
                "command": "stgit.openDiff",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "ctrl+c ctrl+i",
                "command": "stgit.open",
                "when": "!terminalFocus"
            },
            {
                "key": "ctrl+c ctrl+c",
                "command": "stgit.submitComment",
                "when": "activeWebviewPanelId == stgit && stgitEditing && !inQuickOpen && !terminalFocus"
            },
            {
                "key": "escape",
                "command": "stgit.cancel",
                "when": "activeWebviewPanelId == stgit && !stgitEditing && !inQuickOpen && !terminalFocus && !inputFocus"
            },
            {
                "key": "h",
                "command": "sdiff.help",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "p",
                "command": "sdiff.gotoPreviousHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "n",
                "command": "sdiff.gotoNextHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "ctrl-c ctrl-a",
                "command": "sdiff.applyHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "ctrl-c ctrl-u",
                "command": "sdiff.revertHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "s",
                "command": "sdiff.stageHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "u",
                "command": "sdiff.unstageHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "enter",
                "command": "sdiff.openFile",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "ctrl-c ctrl-s",
                "command": "sdiff.splitHunk",
                "when": "resourceScheme == stgit-diff && editorTextFocus"
            },
            {
                "key": "ctrl-x =",
                "command": "sdiff.openCurrentFileDiff",
                "when": "editorTextFocus && !editorReadonly && !inDiffEditor"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./ && npm run compile:webview",
        "compile:webview": "tsc --noEmit -p tsconfig.webview.json && esbuild src/webview/index.tsx --bundle --platform=browser --format=iife --jsx=automatic --minify --target=es2020 --outdir=out/webview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "watch": "concurrently -k \"tsc --watch -p ./\" \"tsc --noEmit --watch -p tsconfig.webview.json\" \"npm run watch:webview\"",
        "watch:webview": "esbuild src/webview/index.tsx --bundle --platform=browser --format=iife --jsx=automatic --target=es2020 --outdir=out/webview --watch",
        "pretest": "npm run compile && npm run lint && npm run test:grammar",
        "lint": "eslint src --ext ts,tsx",
        "test": "node ./out/test/runTest.js",
        "test:unit": "npm run compile && mocha --ui tdd \"out/test/unit/**/*.test.js\" && npm run test:grammar",
        "test:grammar": "vscode-tmgrammar-test 'src/test/syntax/*.test.stgit'",
        "release": "npm run compile && node ./out/release.js",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/glob": "^8.0.3",
        "@types/jsdom": "^30.0.0",
        "@types/mocha": "^9.1.1",
        "@types/node": "16.x",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "^1.91.0",
        "@typescript-eslint/eslint-plugin": "^5.59.0",
        "@typescript-eslint/parser": "^5.59.0",
        "@vscode/test-electron": "^2.1.5",
        "@vscode/vsce": "^3.6.0",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^8.41.0",
        "eslint-config-prettier": "^9.1.2",
        "glob": "^8.0.3",
        "js-yaml": "^4.1.0",
        "jsdom": "^30.1.3",
        "lucide-react": "^1.61.0",
        "mocha": "^10.0.0",
        "prettier": "^3.9.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^5.0.4",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
