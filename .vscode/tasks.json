// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "stgit: compile",
            "type": "npm",
            "script": "compile",
            "problemMatcher": "$tsc"
        },
        {
            "label": "stgit: watch",
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "base": "$tsc-watch",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[0\\].*(Starting compilation in watch mode|File change detected\\. Starting incremental compilation)",
                    "endsPattern": "^\\[0\\].*Found [0-9]+ errors?\\. Watching for file changes\\."
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "stgit: debug",
            "dependsOrder": "sequence",
            "dependsOn": ["stgit: compile", "stgit: watch"],
            "problemMatcher": []
        }
    ]
}
